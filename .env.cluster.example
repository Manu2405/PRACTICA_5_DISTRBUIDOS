# ============================================================
# Variables para modo CLÚSTER — copiar a .env.cluster en cada laptop
# ============================================================
# IMPORTANTE: cada laptop tiene su PROPIO .env.cluster con su IP.
# CASSANDRA_SEEDS apunta SIEMPRE a la IP de la laptop A (la semilla).
# ============================================================

# --- Laptop A (semilla) ---
# NODE_IP=192.168.137.1
# CASSANDRA_SEEDS=192.168.137.1

# --- Laptop B ---
# NODE_IP=192.168.137.50
# CASSANDRA_SEEDS=192.168.137.1

# Backend Node y scripts-data (en ambas laptops) deben usar:
# CASSANDRA_HOST=192.168.137.1,192.168.137.50
